{%- if source_updates -%}
from dalang_dict import GitHubFile, build_index, fetch, package_dictionary
{%- else -%}
from pathlib import Path

from dalang_dict import build_index, package_dictionary
{%- endif %}

GITHUB_REPO = "{{ github_owner }}/{{ repo_name }}"
ASSET = "{{ repo_name }}"
TITLE = "{{ repo_name }}"

{% if source_updates -%}
# Locked to a version in sources.lock.json, updated by the Update workflow
SOURCE = GitHubFile("source.json", repo="owner/repo", path="path/to/source.json")
{%- else -%}
SOURCE = Path("vendored_sources/<name>/<file>")
{%- endif %}

INDEX_FIELDS = {
    "author": "",
    "url": f"https://github.com/{GITHUB_REPO}",
    "description": "{{ description }}",
    "attribution": "",
}


def build_banks(source: object) -> dict[str, list]:
    """Converts the source data to bank entries, e.g. {"kanji_bank": [...]}."""
    raise NotImplementedError


def main() -> None:
{%- if source_updates %}
    banks = build_banks(fetch(SOURCE))
{%- else %}
    banks = build_banks(SOURCE)
{%- endif %}
    index = build_index(TITLE, GITHUB_REPO, ASSET, **INDEX_FIELDS)
    package_dictionary(ASSET, index, banks)
